  "notes": [
    {
      "id": "00000004-0000-4000-8000-000000000001",
      "track_id": "00000002-0000-4000-8000-000000000001",
      "user_id": "00000003-0000-4000-8000-000000000001",
      "body": "이어폰을 잠시 빼니 바람 소리가 들렸다. 오늘의 끝은 이런 노래와 어울릴 것 같았다. 실제 감상이 아닌 데모 기록입니다.",
      "kind": "impression",
      "visibility": "public",
      "created_at": "2026-10-29T12:00:00+09:00",
      "updated_at": "2026-10-29T12:00:00+09:00",
      "is_demo": true
    },
    {
      "id": "00000004-0000-4000-8000-000000000002",
      "track_id": "00000002-0000-4000-8000-000000000002",
      "user_id": "00000003-0000-4000-8000-000000000002",
      "body": "어떤 음악은 목적지보다 돌아가는 길을 떠올리게 한다. 길었던 하루를 천천히 접는 마음으로. 데모 기록입니다.",
      "kind": "impression",
      "visibility": "public",
      "created_at": "2026-10-29T12:00:00+09:00",
      "updated_at": "2026-10-29T12:00:00+09:00",
      "is_demo": true
    },
    {
      "id": "00000004-0000-4000-8000-000000000003",
      "track_id": "00000002-0000-4000-8000-000000000003",
      "user_id": "00000003-0000-4000-8000-000000000003",
      "body": "이 계절을 나중에는 어떤 소리로 기억하게 될까. 잊고 싶지 않은 순간을 여기에 남겨 둔다. 데모 기록입니다.",
      "kind": "impression",
      "visibility": "public",
      "created_at": "2026-10-29T12:00:00+09:00",
      "updated_at": "2026-10-29T12:00:00+09:00",
      "is_demo": true
    }
  ],
  "stories": [
    {
      "id": "00000005-0000-4000-8000-000000000001",
      "track_id": "00000002-0000-4000-8000-000000000001",
      "title": "소리에 귀 기울이는 또 다른 방법",
      "body": "반복되는 소리를 들으며 자신만의 장면을 떠올려 보세요. 이 글은 기능을 소개하는 독자적 예시이며 실제 곡에 관한 사실 설명이 아닙니다.",
      "source_url": null,
      "author_id": "00000003-0000-4000-8000-000000000001",
      "is_demo": true,
      "visibility": "public",
      "created_at": "2026-10-29T00:00:00Z"
    },
    {
      "id": "00000005-0000-4000-8000-000000000002",
      "track_id": "00000002-0000-4000-8000-000000000002",
      "title": "한 곡에서 시작하는 작은 기록",
      "body": "정답을 찾기보다 내게 남은 감각을 한 줄로 적어 보세요. 이 글은 데모 해설입니다.",
      "source_url": null,
      "author_id": "00000003-0000-4000-8000-000000000001",
      "is_demo": true,
      "visibility": "public",
      "created_at": "2026-10-29T00:00:00Z"
    },
    {
      "id": "00000005-0000-4000-8000-000000000003",
      "track_id": "00000002-0000-4000-8000-000000000003",
      "title": "음악을 오래 간직하는 법",
      "body": "곡, 기억, 플레이리스트를 연결하면 나만의 음악 지도가 생깁니다. 데모 안내입니다.",
      "source_url": null,
      "author_id": "00000003-0000-4000-8000-000000000001",
      "is_demo": true,
      "visibility": "public",
      "created_at": "2026-10-29T00:00:00Z"
    }
  ],
