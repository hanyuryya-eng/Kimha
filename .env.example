# Supabase 프로젝트 설정 → API. 공개 키만 사용하며 service_role은 앱에 넣지 않습니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 미설정이면 읽기 전용 데모. 배포 시 실제 https URL로 설정합니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# SUPABASE_TEST_URL / SUPABASE_TEST_ANON_KEY / SUPABASE_TEST_SERVICE_ROLE_KEY:
# 로컬 DB 통합 테스트에만 사용. scripts/test-db.mjs 참조. Git에 커밋하지 마세요.

# auto(기본): 기존 로컬 개발 / demo: 강제 읽기 전용 / supabase: DB 설정 필수
JI_EUM_DATA_MODE=auto
# Vercel은 SITE_URL 미설정 시 실제 배포 도메인을 사용합니다. localhost 값을 운영에 복사하지 마세요.
